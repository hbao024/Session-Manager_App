<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- For local demo only. In deployment prefer QL_SESSION_SQL_CONNECTION. -->
        <add name="SqlConnection"
             connectionString="Server=HOANGBAO;Database=dbSessionManager;User Id=sa;Password=123;TrustServerCertificate=True;" />
    </connectionStrings>
    <appSettings>
        <add key="RedisConnection" value="127.0.0.1:6379" />
        <add key="RedisDatabase" value="4" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
